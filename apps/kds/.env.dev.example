# Shape of apps/kds/.env.dev, which scripts/dev-bootstrap.ps1 writes at the
# end of its run (T12). Mirrors the apps/pos/.env.dev.example convention.
#
# Do NOT fill this in by hand and do NOT commit a real .env.dev — it is
# gitignored (.gitignore:30, the general `.env.dev` pattern).
#
# IMPORTANT — Vite does NOT load a file named `.env.dev` by default. Vite
# loads `.env`, `.env.local`, `.env.[mode]` and `.env.[mode].local`; the dev
# server's default mode is "development", so plain `pnpm dev` looks for
# `.env.development`, not this file. This file is read only when you pass
# `--mode dev` explicitly:
#
#     pnpm dev --host 0.0.0.0 --mode dev
#
# The name matches apps/pos/.env.dev for convention's sake, but that file is
# parsed by run-dev.ps1 (a PowerShell KEY=VALUE reader) and never goes near
# Vite — the convention does not carry over automatically, hence `--mode dev`
# above. Verified by building with `pnpm build --mode dev` and confirming the
# configured URL lands in the compiled bundle; `--mode dev` is REQUIRED, not
# cosmetic.

# Edge node LAN WebSocket endpoint. Host must be the machine running the POS
# (or the standalone edge/device kds-lan-server) — its LAN IP, never
# localhost/127.0.0.1, or a second machine cannot reach it. Port 9310 is the
# pinned default bind port (edge/device/src/bin/kds_lan_server.rs,
# apps/pos/src-tauri/src/state.rs::DEFAULT_LAN_BIND_ADDR).
VITE_KDS_LAN_URL=ws://192.168.1.50:9310/kds

# Seeded dev outlet — edge/database/src/bin/devseed.rs OUTLET_ID.
VITE_KDS_OUTLET_ID=0191a000-0000-7000-8000-00000000000a

# Seeded KDS device row — edge/database/src/bin/devseed.rs KDS_DEVICE_ID.
# The server performs no device lookup today (server.rs handle_connection
# checks only that the id is non-empty — see docs/backlog-m2.md "Device
# enrollment"), so this id matters for the audit trail, not for admission.
VITE_KDS_DEVICE_ID=0191a000-0000-7000-8000-00000000000d

# Optional station filter. Unset = this screen receives every station's
# tickets. Set to a station code (e.g. TANDOOR) to filter.
# VITE_KDS_STATION=

# Enrolled device credential (ADR-017), POST /devices/enroll response's
# "token" field, "<credential_id>.<secret>". Sent as the connection's first
# WS frame, never in the URL (lanConfig.ts AUTHENTICATION note). NOT written
# by dev-bootstrap.ps1 today (T12 predates ADR-017) — fill in by hand from a
# real enrollment until that script is updated to source it.
VITE_KDS_DEVICE_TOKEN=
