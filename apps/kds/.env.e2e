# Shape read by Vite when `playwright.config.ts` starts the dev server with
# `--mode e2e` for the browser smoke test (T13). Not secret: a fixed local
# port and fixed development-only UUIDs, so it is tracked (unlike
# `.env.dev`, which carries the edge encryption key — see .gitignore).
#
# `tests/smoke.spec.ts` starts an in-process stub WebSocket server on
# VITE_KDS_LAN_URL's port before the browser navigates to the page. These
# values must stay in sync with the constants at the top of that file.
VITE_KDS_LAN_URL=ws://127.0.0.1:9401/kds
VITE_KDS_OUTLET_ID=018e5a2e-0000-7000-8000-0000000000e2
VITE_KDS_DEVICE_ID=018e5a2e-0000-7000-8000-0000000000e3
